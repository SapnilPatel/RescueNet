# Copy to .env (never commit .env). Both HQ and beacon read it.
# Keep comments on their own lines; values are taken literally.

# --- HQ ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
RETELL_API_KEY=
RETELL_FROM_NUMBER=+1XXXXXXXXXX
RETELL_TO_NUMBER=+1XXXXXXXXXX
RETELL_AGENT_ID=
# Auto-call the dispatcher for: critical | high | off
AUTO_CALL=critical
AUTO_CALL_COOLDOWN_S=60
# If set, dashboard buttons need ?token=... in the URL once
DISPATCH_TOKEN=
MAP_LAT=34.0205
MAP_LON=-118.2856

# --- shared ---
# If set on HQ, the beacon must send the same value
BEACON_KEY=

# --- Beacon ---
BEACON_ID=beacon-android-01
HQ_URL=https://rescuenet-hq.onrender.com
SYNC_INTERVAL=10
# Fallback position if termux-location is unavailable
# BEACON_LAT=34.0205
# BEACON_LON=-118.2856
